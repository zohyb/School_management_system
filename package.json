{
  "description": "School Management System SaaS: marketing site, school dashboard app, SaaS admin panel, and API.",
  "engines": {
    "node": ">=20"
  },
  "name": "sms-monorepo",
  "private": true,
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "dev:admin": "npm run dev --workspace=@sms/admin",
    "dev:app": "npm run dev --workspace=@sms/app",
    "dev:landing": "npm run dev --workspace=@sms/landing",
    "dev:server": "npm run dev --workspace=@sms/server"
  },
  "type": "module",
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "server"
  ],
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^7.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0"
  }
}